# ---------------------------------------------------------------------------
# Ombor AI backend — nusxa oling:  cp .env.example .env
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase → Project Settings → Database → Connection string.
# Session pooler (5432) yoki to'g'ridan-to'g'ri ulanish:
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Transaction pooler (6543) ishlatsangiz — true qiling:
DB_USE_PGBOUNCER=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# Next.js frontend manzillari (vergul bilan)
CORS_ORIGINS=http://localhost:3000

# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
# Legacy JWT secret (HS256). Bo'sh qoldirilsa, JWKS (asimmetrik kalitlar) ishlatiladi.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# AI agent uchun API kalit(lar). Kamida 32 belgi. Yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_AGENT_API_KEYS=change-me-to-a-long-random-secret-at-least-32-chars
# Agent qaysi rol huquqlari bilan ishlaydi: admin | manager | viewer
AI_AGENT_ROLE=manager
