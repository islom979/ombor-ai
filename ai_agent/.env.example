# ---------------------------------------------------------------------------
# Ombor AI agent — nusxa oling:  cp .env.example .env
# ---------------------------------------------------------------------------

# Anthropic API kaliti (https://console.anthropic.com). SDK avtomatik o'qiydi.
ANTHROPIC_API_KEY=sk-ant-...

# FastAPI backend
OMBOR_API_URL=http://localhost:8000/api/v1
# backend/.env dagi AI_AGENT_API_KEYS qiymatlaridan biri
OMBOR_API_KEY=change-me-to-a-long-random-secret-at-least-32-chars
OMBOR_API_TIMEOUT=30

# Claude sozlamalari
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=16000
CLAUDE_SERVER_FALLBACKS=true
AGENT_MAX_TURNS=15

# false — agent faqat o'qiydi (kirim/chiqim/to'lov qila olmaydi)
AGENT_ALLOW_WRITES=true

# Worker (dashboard buyruqlar navbati)
WORKER_ID=ai-worker-1
WORKER_POLL_INTERVAL=2
WORKER_CONCURRENCY=2

LOG_LEVEL=INFO
